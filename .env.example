# .env.exampleに最低限の設定を追加
echo "LINE_CHANNEL_ACCESS_TOKEN=your_line_token_here" > .env.example
echo "LINE_CHANNEL_SECRET=your_line_secret_here" >> .env.example  
echo "OPENAI_API_KEY=your_openai_key_here" >> .env.example
echo "DATABASE_URL=mysql://app_user:app_password@mysql:3306/rap_bot" >> .env.example
# .env.exampleに環境変数テンプレートを追加
cat > .env.example << 'EOF'
# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_line_token_here
LINE_CHANNEL_SECRET=your_line_secret_here

# OpenAI API
OPENAI_API_KEY=your_openai_key_here

# Database
DATABASE_URL=mysql://app_user:app_password@mysql:3306/rap_bot

# Application
NODE_ENV=development
EOF